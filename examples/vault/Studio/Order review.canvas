      "height": 130
    },
    {
      "id": "plan",
      "type": "text",
      "text": "AGENT:\n{\"prompt\": \"Write an English implementation plan from the supplied policy. Return JSON text with tasks, tests and risks arrays. Include at least 2 tasks, 3 tests, and 1 risk. Do not generate code.\", \"schema\": \"json\", \"max_retries\": 1}",
      "x": 810,
      "y": 45,
      "width": 220,
      "height": 130
    },
    {
      "id": "review",
      "type": "text",
      "text": "AGENT:\n{\"prompt\": \"The policy is not approved. Return JSON text with tasks, tests and risks arrays describing review work. Include at least 2 tasks, 3 checks, 1 risk. Do not implement code.\", \"schema\": \"json\", \"max_retries\": 1}",
      "x": 550,
      "y": 335,
      "width": 220,
      "height": 130
    },
    {
      "id": "join",
      "type": "text",
      "text": "JOIN: ANY",
