    "contracts": {
      "plan": {
        "description": "Pinned policy and essential rules must reach the model.",
        "input": {
          "required_sources": [
            {
              "path": "Studio/Specification.md",
              "sha256": "b95b3dc6eaf166cfceaf4dfdce269b7496e9607369de75dbf8106daa4ffd05fc",
              "version": {
                "key": "revision",
                "equals": 3
              },
              "role": "policy"
            }
          ],
          "allowed_sources": [
            "Studio/Specification.md"
          ],
          "required_text": [
            "POLICY_ID: order-v3",
            "Reject booleans as integers",
            "Reject duplicate SKUs",
            "Use integer cents"
          ]
        },
        "output": {
          "required_fields": [
            "tasks",
            "tests",
            "risks"
          ],
          "schema": {
            "type": "object",
