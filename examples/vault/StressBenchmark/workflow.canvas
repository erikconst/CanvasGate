    },
    {
      "id": "dispatch",
      "type": "text",
      "text": "AGENT:\n{\"prompt\": \"Solve the medium-complexity dispatch planning task in English using the CURRENT policy, fleet and orders. Ignore superseded and unrelated documents. Follow the deterministic greedy policy exactly; do not optimize it. Return the outer JSON object {status:true, confidence:number, text:string}. The text field must contain ONLY a JSON-encoded dispatch result with keys assignments, rejected, truck_loads, total_revenue. assignments: list of {order_id,truck_id} sorted by order_id. rejected: list of {order_id,reason} sorted by order_id. truck_loads: list of {truck_id,weight_kg,volume_m3} sorted by truck_id, including unused trucks. total_revenue: integer sum of assigned order revenue. Do not include commentary or Markdown fences. Authoritative sources have YAML status: current AND domain: dispatch. Other domains and superseded revisions are not authoritative.\", \"schema\": \"json\", \"max_retries\": 0}",
      "x": 2620,
      "y": 0,
      "width": 500,
      "height": 420
    },
    {
      "id": "output",
      "type": "text",
      "text": "OUTPUT: Checked dispatch candidate",
      "x": 3220,
      "y": 0,
      "width": 340,
      "height": 160
    }
  ],
