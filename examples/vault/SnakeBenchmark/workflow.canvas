    {
      "id": "model",
      "type": "text",
      "text": "AGENT:\n{\"prompt\": \"Create a polished, cohesive procedural 3D snake in JavaScript for Three.js r186. Use only the current snake3d specification and honor its module contract and all six animation states. Current notes have YAML status=current and domain=snake3d; selected excerpts repeat those authority fields. Superseded rules and other domains are irrelevant. Return outer JSON with status, confidence, text. The text must be the COMPLETE JavaScript ES module source, without Markdown fences or explanations. No imports: the renderer passes THREE to createSnake. No file changes, tools, network, DOM, timers or random calls. One independent implementation; do not refer to another variant. Keep the source compact, preferably under 300 lines.\", \"max_retries\": 0}",
      "x": 2120,
      "y": 0,
      "width": 500,
      "height": 400
    },
    {
      "id": "output",
      "type": "text",
      "text": "OUTPUT: Procedural snake module",
      "x": 2740,
      "y": 0,
      "width": 320,
      "height": 150
    }
  ],
